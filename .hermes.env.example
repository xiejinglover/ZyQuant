# Template only — never fill this file in. Copy it to `.env`, which .gitignore
# excludes via the `.env` / `*.env` rules (this `.example` is kept by the
# `!*.env.example` negation):
#
#   cp .hermes.env.example .env && chmod 600 .env
#
# Add the password without leaving it in shell history:
#
#   read -rs -p 'Hermes password: ' P \
#     && printf 'HERMES_MYSQL_PASSWORD=%s\n' "$P" >> ./.env \
#     && unset P && echo
#
# Load it into the process environment for one command:
#
#   set -a; . ./.env; set +a
#   zyq data acquire resume --root ./data --job-id <job>
#
# Only the process environment is read (see HermesCredentials.from_env); the
# state database, logs, manifest and lineage record host, database, port and a
# hash of the user, never the user name in clear text and never the password.
HERMES_MYSQL_HOST=
HERMES_MYSQL_PORT=3306
HERMES_MYSQL_USER=
HERMES_MYSQL_PASSWORD=
HERMES_MYSQL_DATABASE=hermes
